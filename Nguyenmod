
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dong AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10131c;color:white;font-family:Arial}
header{padding:18px;background:#191e2b;border-bottom:1px solid #343a4b;font-size:23px;font-weight:bold;color:#75a7ff}
main{max-width:700px;margin:auto;padding:20px 15px 120px}
h1{text-align:center;margin-top:65px}
.sub{text-align:center;color:#aaa}
#chat{display:flex;flex-direction:column;gap:15px;margin-top:30px}
.msg{padding:13px 16px;border-radius:15px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
.user{background:#3156a4;align-self:flex-end;max-width:90%}
.bot{background:#252a38;align-self:stretch}
.bottom{position:fixed;bottom:0;left:0;right:0;background:#10131c;padding:12px}
.form{max-width:670px;margin:auto;display:flex;gap:8px;background:#252a38;border:1px solid #454c60;border-radius:22px;padding:8px}
textarea{flex:1;min-width:0;resize:none;background:transparent;color:white;border:0;outline:0;padding:10px;font-size:16px}
button{border:0;border-radius:15px;background:#75a7ff;color:#10131c;font-weight:bold;padding:12px;cursor:pointer}
.note{text-align:center;font-size:11px;color:#888;margin-top:8px}
</style>
</head>
<body>
<header>✦ Dong AI</header>
<main>
<h1 id="welcome">Xin chào! 👋</h1>
<p class="sub" id="sub">Bạn muốn hỏi gì hôm nay?</p>
<div id="chat"></div>
</main>
<div class="bottom">
<div class="form">
<textarea id="input" rows="1" placeholder="Nhập câu hỏi của bạn..."></textarea>
<button onclick="send()">Gửi ➤</button>
</div>
<div class="note">Dong AI · Phiên bản thử nghiệm</div>
</div>
<script>
const input=document.getElementById("input");
const chat=document.getElementById("chat");

function add(text,type){
 const el=document.createElement("div");
 el.className="msg "+type;
 el.textContent=text;
 chat.appendChild(el);
 window.scrollTo(0,document.body.scrollHeight);
}

function send(){
 const text=input.value.trim();
 if(!text)return;

 document.getElementById("welcome").style.display="none";
 document.getElementById("sub").style.display="none";
 add(text,"user");
 input.value="";

 let answer="Xin chào! Mình là Dong AI. Bạn vừa hỏi: "+text+
 "\n\nĐây là bản giao diện thử nghiệm. Để trả lời kiến thức thực sự, mình cần kết nối mô hình AI qua API.";

 setTimeout(()=>add(answer,"bot"),300);
}

input.addEventListener("keydown",e=>{
 if(e.key==="Enter"&&!e.shiftKey){
  e.preventDefault();
  send();
 }
});
</script>
</body>
</html>
